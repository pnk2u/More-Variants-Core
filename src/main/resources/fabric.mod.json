{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["pnku"],
  "contact": {
    "homepage": "https://www.pnku.de",
    "email": "contact@pnku.de",
    "sources": "https://github.com/pnk2u/More-Frame-Variants",
    "issues": "https://github.com/pnk2u/More-Frame-Variants/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.pnku.more_variants_pale_oak_backport.MoreVariantsPaleOakBackport"
    ],
    "client": [
      "de.pnku.more_variants_pale_oak_backport.MoreVariantsPaleOakBackportClient"
    ]
  },
  "mixins": [
    "${mod_id_short}.mstv.base.mixins.json",
    "${mod_id_short}.more_barrel_variants.mixins.json",
    "${mod_id_short}.more_beehive_variants.mixins.json",
    "${mod_id_short}.more_bookshelf_variants.mixins.json",
