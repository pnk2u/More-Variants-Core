		"fabric-api": "*"
	},
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.lieonlion.dev"
      }
    },
    "mc-publish": {
      "modrinth": "vD5gEL9d",
      "curseforge": "1517935",
      "dependencies": [
        "fabric-api(required)#(ignore)"
      ]
    }
  }
}
